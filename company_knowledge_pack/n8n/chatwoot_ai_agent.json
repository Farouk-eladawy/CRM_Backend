      "name": "Chatwoot Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($json.body && typeof $json.body === 'object' && !Array.isArray($json.body)) ? $json.body : $json;\nconst event = String(raw.event || '');\nconst messageType = raw.message_type;\nconst incoming = messageType === 'incoming' || messageType === 0 || messageType === '0';\nconst content = String(raw.content || '').trim();\nif ((event && event !== 'message_created') || !incoming || raw.private === true || !content) {\n  return [];\n}\nconst conversation = raw.conversation || {};\nconst account = raw.account || {};\nconst sender = raw.sender || {};\nconst contact = (conversation.meta && conversation.meta.sender) || sender;\nconst history = Array.isArray(conversation.messages) ? conversation.messages.slice(-8) : [];\nreturn [{\n  json: {\n    content,\n    conversation_id: conversation.id,\n    account_id: account.id || '',\n    inbox_id: conversation.inbox_id || (raw.inbox && raw.inbox.id) || '',\n    sender_name: contact.name || sender.name || '',\n    sender_phone: contact.phone_number || sender.phone_number || '',\n    sender_email: contact.email || sender.email || '',\n    history_text: history.map((m) => (m.message_type === 1 || m.message_type === 'outgoing' ? 'agent' : 'customer') + ': ' + String(m.content || '')).join('\\n')\n  }\n}];"
      },
