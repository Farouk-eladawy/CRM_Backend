    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.crm_base_url.replace(/\\/$/, '') + '?phone=' + encodeURIComponent($json.sender_phone || '') + '&email=' + encodeURIComponent($json.sender_email || '') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.crm_api_token }}"
            }
          ]
