        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.llm_model, temperature: 0.2, messages: [{ role: 'system', content: $json.system_prompt }, { role: 'user', content: $json.user_prompt }] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "http-3",
      "name": "Ask model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3020,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const built = $('Build prompt').first().json;\nconst llmReply = $json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content;\nlet reply = String(llmReply || built.strict_answer || '').trim();\nlet escalate = /\\[ESCALATE\\]/i.test(reply);\nreply = reply\n  .replace(/\\[ESCALATE\\]/gi, '')\n  .replace(/\\[LANGUAGE:[^\\]]+\\]/gi, '')\n  .replace(/\\[INTENT:[^\\]]+\\]/gi, '')\n  .replace(/\\[DEPT:[^\\]]+\\]/gi, '')\n  .trim();\nif (!reply) {\n  reply = 'Thank you for your message. A teammate will follow up shortly.';\n  escalate = true;\n}\nconst accountId = built.account_id || built.chatwoot_account_id;\nreturn [{\n  json: {\n    ...built,\n    reply,\n    escalate,\n    account_id: accountId\n  }\n}];"
