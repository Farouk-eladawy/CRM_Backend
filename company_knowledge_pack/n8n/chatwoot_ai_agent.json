    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Company settings').item.json.knowledge_file }}",
        "options": {}
      },
      "id": "file-1",
      "name": "Read knowledge file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1460,
        440
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const settings = $('Company settings').first().json;\nlet knowledge = {};\nconst item = $input.first();\ntry {\n  if (item.binary && item.binary.data) {\n    const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n    knowledge = JSON.parse(buf.toString('utf8'));\n  } else if (item.json && (item.json.documents || item.json.reply_rules || item.json.company)) {\n    knowledge = item.json;\n  }\n} catch (error) {\n  knowledge = {};\n}\nconst company = knowledge.company || {};\nreturn [{\n  json: {\n    ...settings,\n    company_name: settings.company_name || company.company_name || '',\n    assistant_name: settings.assistant_name || company.assistant_name_en || company.assistant_name || '',\n    signature: settings.signature || company.signature_en || '',\n    reply_rules: knowledge.reply_rules || '',\n    documents: knowledge.documents || [],\n    trips: knowledge.trips || [],\n    strict_qa: knowledge.strict_qa || [],\n    facebook_ads: knowledge.facebook_ads || {},\n    learned_corrections: knowledge.learned_corrections || [],\n    knowledge_loaded: Boolean(knowledge.documents && knowledge.documents.length),\n    context_marker: 'prepare'\n  }\n}];"
      },
