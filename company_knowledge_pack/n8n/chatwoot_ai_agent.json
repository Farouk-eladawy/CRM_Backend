      },
      "id": "http-2",
      "name": "Lookup external CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Prepare context').first().json;\nconst incoming = $input.first().json;\nconst crmText = incoming.context_marker === 'prepare' ? '' : JSON.stringify(incoming).slice(0, 4000);\n\nfunction tokens(value) {\n  return new Set(String(value || '').toLowerCase().split(/[^0-9A-Za-z\\u0600-\\u06FF]+/).filter((word) => word.length > 2));\n}\nfunction score(query, text) {\n  const wanted = tokens(query);\n  const found = tokens(text);\n  let count = 0;\n  for (const word of wanted) {\n    if (found.has(word)) count += 1;\n  }\n  return count;\n}\nfunction norm(value) {\n  return String(value || '').toLowerCase().replace(/[^\\u0600-\\u06FFa-z0-9\\s]/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nconst question = norm(ctx.content);\nlet strictAnswer = '';\nfor (const rule of ctx.strict_qa || []) {\n  if (rule.is_enabled === false) continue;\n  if (norm(rule.question) && norm(rule.question) === question) {\n    strictAnswer = String(rule.answer || '').trim();\n    break;\n  }\n}\n\nconst rankedDocs = (ctx.documents || [])\n  .map((doc) => ({ doc, score: score(ctx.content, (doc.filename || '') + '\\n' + (doc.content || '')) }))\n  .filter((row) => row.score > 0)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 4)\n  .map((row) => row.doc);\nconst docs = rankedDocs.length ? rankedDocs : (ctx.documents || []).slice(0, 2);\nlet docText = docs.map((doc) => '### ' + (doc.filename || 'document') + '\\n' + String(doc.content || '').slice(0, 3500)).join('\\n\\n');\n\nconst rankedTrips = (ctx.trips || [])\n  .map((trip) => ({ trip, score: score(ctx.content, (trip.title || '') + '\\n' + (trip.description || '')) }))\n  .filter((row) => row.score > 0)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 3)\n  .map((row) => row.trip);\nconst tripText = rankedTrips.map((trip) => '- ' + trip.title + ': ' + String(trip.description || '').slice(0, 400)).join('\\n');\n\nconst adLines = Object.entries(ctx.facebook_ads || {}).map(([id, item]) => id + ' => ' + (item.program || item.family || '')).join('\\n');\nconst examples = (ctx.learned_corrections || []).slice(-5).map((row) => JSON.stringify(row).slice(0, 300)).join('\\n');\n\nconst system = [\n  'You are ' + (ctx.assistant_name || 'the assistant') + ' for ' + (ctx.company_name || 'the company') + '.',\n  'Reply in the customer language. Use only the knowledge below and the CRM lookup. If a fact is missing, say you will check with the team. Do not invent prices, phone numbers, or booking times.',\n  'If the customer explicitly asks for a human, start the reply with [ESCALATE].',\n  ctx.signature ? ('Sign the reply with:\\n' + ctx.signature) : '',\n  'REPLY RULES:\\n' + String(ctx.reply_rules || '').slice(0, 6000),\n  'DOCUMENTS:\\n' + docText.slice(0, 14000),\n  tripText ? ('TRIPS:\\n' + tripText) : '',\n  adLines ? ('AD MAP:\\n' + adLines) : '',\n  examples ? ('STYLE EXAMPLES:\\n' + examples) : ''\n].filter(Boolean).join('\\n\\n');\n\nconst user = [\n  ctx.sender_name ? ('Customer: ' + ctx.sender_name) : '',\n  ctx.sender_phone ? ('Phone: ' + ctx.sender_phone) : '',\n  ctx.sender_email ? ('Email: ' + ctx.sender_email) : '',\n  ctx.history_text ? ('Recent messages:\\n' + ctx.history_text) : '',\n  crmText ? ('External CRM lookup:\\n' + crmText) : '',\n  'Latest message:\\n' + ctx.content\n].filter(Boolean).join('\\n\\n');\n\nreturn [{\n  json: {\n    ...ctx,\n    system_prompt: system,\n    user_prompt: user,\n    strict_answer: strictAnswer,\n    use_llm: !strictAnswer\n  }\n}];"
      },
